# Copiar a .env y ajustar. No commitear .env real.

# --- Postgres / TimescaleDB ---
POSTGRES_USER=sitciit
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sitciit
# Puerto publicado en el host. 5433 por defecto porque muchas máquinas ya
# tienen un Postgres nativo/otro contenedor en 5432. Cambiar si 5433 también
# está ocupado.
POSTGRES_HOST_PORT=5433

# --- MQTT (credenciales de referencia; los usuarios reales viven en
# mosquitto/config/passwd, generado con scripts/create-mqtt-user.sh) ---
MQTT_DEV_USER=sitciit-dev
MQTT_DEV_PASSWORD=changeme
